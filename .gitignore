# --- 运行时与依赖（随盘携带，不提交 git） ---
.cache/

# --- 运行期数据（含明文凭据，绝不提交 git） ---
data/dsh/
data/logs/

# --- 默认工作区（用户项目文件） ---
work/

# --- ready 标记 / 版本标记（Release 打包时生成，不提交） ---
.ready.flag
HARNESS_VERSION

# --- 补丁校验缓存（tgz 可重新下载生成，不入库） ---
.patch-check-cache/

# --- 升级/排障过程中的临时下载与解包（含上游源码快照与便携 node，体积大，不入库） ---
.tmp-upstream/

# --- 回滚备份（原始 dsh 文件） ---
.backup/

# --- 系统/编辑器 ---
Thumbs.db
Desktop.ini
.DS_Store
*.log
